--- !u!114 &537742949
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 537742948}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5da1d334ee630e3498d418f6466a1f5a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EOSMenuUI
  networkManager: {fileID: 1460922032}
  idInputField: {fileID: 248326149}
  myIdText: {fileID: 1547583139}
  roomManager: {fileID: 1884140519}
  uiPanel: {fileID: 1837473308}
  placeholderPanel: {fileID: 1002612722}
  warningPanel: {fileID: 1523600595}
  imageTransform: {fileID: 27411467}
  rotationSpeed: 50
  hintText: {fileID: 284724398}
  changeInterval: 5
  hints:
  - "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0448\u0430\u0439\u0431\u044B
    \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0441\u0438\u043B\u044B
    \u0432\u0430\u0448\u0435\u0433\u043E \u0443\u0434\u0430\u0440\u0430. \u0411\u0435\u0439\u0442\u0435
    \u0440\u0435\u0437\u0447\u0435!"
  - "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0431\u043E\u0440\u0442\u0430
    \u0434\u043B\u044F \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u043E\u0432, \u0447\u0442\u043E\u0431\u044B
    \u0437\u0430\u043F\u0443\u0442\u0430\u0442\u044C \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430"
  - "\u041D\u0435 \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u0439\u0442\u0435\u0441\u044C
    \u043A \u0441\u0432\u043E\u0438\u043C \u0432\u043E\u0440\u043E\u0442\u0430\u043C
    - \u0442\u0430\u043A \u0441\u043B\u043E\u0436\u043D\u0435\u0435 \u043E\u0442\u0440\u0430\u0437\u0438\u0442\u044C
    \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u0443\u0434\u0430\u0440"
  - "\u0417\u0430\u0449\u0438\u0449\u0430\u0439\u0442\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
    \u0446\u0435\u043D\u0442\u0440\u043E\u043C \u0431\u0438\u0442\u044B, \u0447\u0442\u043E\u0431\u044B
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u0442\u0441\u043A\u043E\u043A\u0430"
  - "\u0418\u043D\u043E\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0438\u0439 \u0441\u0435\u0439\u0432
    - \u044D\u0442\u043E \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E
    \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u043D\u0430
    \u043F\u0443\u0442\u0438 \u0448\u0430\u0439\u0431\u044B \u0431\u0438\u0442\u0430"
  - "\u041E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u0439\u0442\u0435 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430:
    \u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0432\u0438\u0434, \u0447\u0442\u043E
    \u0431\u044C\u0435\u0442\u0435 \u0432 \u043E\u0434\u0438\u043D \u0443\u0433\u043E\u043B,
    \u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0432
    \u0434\u0440\u0443\u0433\u043E\u0439"
  - "\u042D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0439
    \u0431\u043E\u0442 \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u043E\u0448\u0438\u0431\u043E\u043A.
    \u0413\u043E\u0442\u043E\u0432\u044B \u043F\u0440\u0438\u043D\u044F\u0442\u044C
    \u0432\u044B\u0437\u043E\u0432?"
  - "\u0411\u043E\u0442\u044B \u043D\u0430 \u043B\u0435\u0433\u043A\u043E\u043C \u0443\u0440\u043E\u0432\u043D\u0435
    \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u043E\u0442\u043B\u0438\u0447\u043D\u043E
    \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 \u0434\u043B\u044F \u0440\u0430\u0437\u043C\u0438\u043D\u043A\u0438
    \u043F\u0435\u0440\u0435\u0434 \u043C\u0430\u0442\u0447\u0435\u043C"
  - "\u041D\u0430\u0448 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442 \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0435\u0442
    \u043E\u0448\u0438\u0431\u043A\u0438, \u043F\u0440\u044F\u043C\u043E \u043A\u0430\u043A
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A!"
  - "\u0422\u0440\u0435\u043D\u0438\u0440\u0443\u0439\u0442\u0435\u0441\u044C \u043D\u0430
    \u0431\u043E\u0442\u0430\u0445 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u043E\u0439
    \u0438\u0433\u0440\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0442\u044C
    \u0432 \u043E\u043D\u043B\u0430\u0439\u043D-\u043C\u0430\u0442\u0447\u0430\u0445"
  - "\u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435 \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u044B\u0435
    \u043A\u0432\u0435\u0441\u0442\u044B, \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u0441\u0442\u0440\u0435\u0435
    \u043F\u043E\u0432\u044B\u0448\u0430\u0442\u044C \u0441\u0432\u043E\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    XP"
  - "\u0417\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0439\u0442\u0435 \u0432\u043E
    \u0432\u043A\u043B\u0430\u0434\u043A\u0443 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0439
    - \u0437\u0430 \u043D\u0438\u0445 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u043A\u0440\u0443\u0442\u044B\u0435 \u043D\u0430\u0433\u0440\u0430\u0434\u044B"
  - "\u041A\u0430\u0436\u0434\u043E\u0435 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0435
    \u043E\u0447\u043A\u043E \u043E\u043F\u044B\u0442\u0430 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442
    \u0432\u0430\u0441 \u043A \u0437\u0432\u0430\u043D\u0438\u044E \u043C\u0430\u0441\u0442\u0435\u0440\u0430
    AirClash"
  - "\u042D\u043B\u043E-\u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u043E\u0434\u0431\u0435\u0440\u0435\u0442
    \u0432\u0430\u043C \u0440\u0430\u0432\u043D\u044B\u0445 \u043F\u043E \u0441\u0438\u043B\u0435
    \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432"
  - "\u041D\u0430\u0448\u043B\u0438 \u0431\u0430\u0433 \u0438\u043B\u0438 \u0435\u0441\u0442\u044C
    \u0438\u0434\u0435\u044F? \u041D\u0430\u043F\u0438\u0448\u0438\u0442\u0435 \u043D\u0430\u043C
    \u043D\u0430 \u043F\u043E\u0447\u0442\u0443 \u0438\u043B\u0438 \u0437\u0430\u043B\u0435\u0442\u0430\u0439\u0442\u0435
    \u0432 Telegram-\u043A\u0430\u043D\u0430\u043B!"
